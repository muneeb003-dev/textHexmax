{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.htm",
      "destination": "/index",
      "permanent": true
    },
    {
      "source": "/:path*/index.htm",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/:slug.htm",
      "destination": "/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/index",
      "destination": "/index.html"
    }
  ]
}
